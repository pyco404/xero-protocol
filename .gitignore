# Repo-wide ignores. site/.gitignore adds the website's own build output (.output, .wrangler, ...).

# Dependencies (site/, protocol/ and sdk/ each have their own)
node_modules/

# Tool caches, local validators and editor/OS noise
.vite/
test-ledger/
.surfpool/
.DS_Store

# Protocol build output and tool state
protocol/.anchor/
protocol/.yarn/
protocol/app/
protocol/target/
**/*.rs.bk

# SDK build output
sdk/dist/

# Keypairs: never commit wallets, buffer keys or program keys. The xero_policy program keypair
# lives in ~/.config/xero/ and is symlinked into protocol/target/deploy/ at build time.
*keypair*.json
*-buffer.json
id.json
*.key
