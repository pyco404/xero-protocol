{
  "license": "ISC",
  "scripts": {
    "build": "sh scripts/link-program-keypair.sh && $HOME/.avm/bin/anchor-1.2.0 build --arch v2",
    "test": "npm run build && npm run test:ts",
    "test:ts": "NODE_OPTIONS=--no-experimental-strip-types ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.ts\"",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "smoke": "NODE_OPTIONS=--no-experimental-strip-types ts-node -P ./tsconfig.json scripts/smoke.ts",
    "deploy:localnet": "solana program deploy target/deploy/xero_policy.so --program-id $HOME/.config/xero/xero_policy-keypair.json --keypair $HOME/.config/solana/id.json --upgrade-authority $HOME/.config/solana/id.json --url ${RPC_URL:-http://127.0.0.1:8899}"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0"
  },
  "devDependencies": {
    "@solana/kit": "^8.3.0",
    "@solana/spl-token": "^0.4.15",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "litesvm": "^1.4.1",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  },
  "name": "xero-protocol",
  "private": true
}
